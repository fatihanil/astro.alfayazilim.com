---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { render } from "astro:content";
import ContactSection from "@/components/sections/ContactSection.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import ReferencesLogoSection from "@/components/sections/ReferencesLogoSection.astro";

const entry = await getEntryCTM("pages", "referanslar", "tr");
const { Content } = await render(entry);
---

<Base {...entry.data}>
  <PageHeader
    title={entry.data.title}
    breadcrumbTitle={entry.data.breadcrumbTitle || entry.data.title}
  />
  <ReferencesLogoSection />
  <section class="section">
    <div class="container">
      <div class="prose-styles content">
        <Content />
      </div>
    </div>
  </section>
  <ContactSection />
</Base>
